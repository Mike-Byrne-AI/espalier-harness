[0.0075, "o", "\u001b[?25l\u001b[2D\u001b[4B\r\u001b[9A\u001b[38;2;78;186;101m\u23fa\r\u001b[1B\u001b[38;2;153;153;153m  \u23bf \u00a0\u001b[39mAdded\u001b[12G\u001b[1m1\u001b[14G\u001b[22mline,\u001b[20Gremoved\u001b[28G\u001b[1m1\u001b[30G\u001b[22mline\r\u001b[1B \u001b[3G   \u001b[38;2;248;248;242m\u001b[2m 2691 \u001b[22m         surface + \u001b[38;2;230;219;116m\"  ->  run `/context-load --mode recover`\"\r\u001b[5C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m 2692 \u001b[22m     )\r\u001b[1B\u001b[39m     \u001b[38;2;248;248;242m\u001b[2m 2693 \u001b[22m     header_parts = [\u001b[39m\u001b[K\r\u001b[1B  \u001b[6G\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 2694 -\u001b[38;2;248;248;242m        \"=== \u001b[48;2;92;2;0mEspalier-Harness\u001b[48;2;61;1;0m === POST-COMPACTION RE-ORIENT (mid-session) ===\\n\",                           \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 2694 +\u001b[38;2;248;248;242m        \u001b[38;2;230;219;116m\"=== \u001b[48;2;4;71;0mNorthwind\u001b[48;2;2;40;0m === POST-COMPACTION RE-ORIENT (mid-session) ===\\n\"\u001b[38;2;248;248;242m,                                  \u001b[39m\u001b[49m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;248;248;242m\u001b[2m 2695 \u001b[22m         \u001b[38;2;230;219;116mf\"Repo:      \u001b[38;2;248;248;242m{name}\u001b[38;2;230;219;116m\\n\"\u001b[38;2;248;248;242m,\r\u001b[2C"]
